# ==============================================================================
# SpotifyPulse Environment Configuration (2026 Architecture Audit)
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit the actual .env file containing real secrets to version control.
# ==============================================================================

# Application Execution Mode
# Set to 'true' to run fully offline using synthetic demo data without Spotify API keys.
# Set to 'false' to connect to live Spotify Web API with OAuth 2.0.
SPOTIFY_PULSE_DEMO_MODE=true
SPOTIFY_PULSE_ENVIRONMENT=development
SPOTIFY_PULSE_LOG_LEVEL=INFO
SPOTIFY_PULSE_LOG_JSON_FORMAT=false

# Application Network Bindings
SPOTIFY_PULSE_API_HOST=0.0.0.0
SPOTIFY_PULSE_API_PORT=8000
SPOTIFY_PULSE_DASHBOARD_PORT=8501

# ==============================================================================
# Spotify Web API & OAuth 2.0 Credentials (Confidential Server-Side Backend)
# (Required when SPOTIFY_PULSE_DEMO_MODE=false)
# Obtain from https://developer.spotify.com/dashboard
# Key Policies:
# - Refresh tokens expire after 6 months (June 2026 update); refreshing does not reset.
# - Shared quota across all Client IDs under developer account (July 2026 update).
# - Development Mode requires Premium for app owner; max 5 authorized users.
# ==============================================================================
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8000/auth/callback
SPOTIFY_RATE_LIMIT_MAX_RETRIES=5

# ==============================================================================
# Multi-Tier Data Storage & Retention Policies (Spotify Terms Compliance)
# ==============================================================================
DATA_BRONZE_RETENTION_DAYS=14
DATA_STAGING_RETENTION_DAYS=30
DATA_FACTS_RETENTION_DAYS=730
DATA_SNAPSHOTS_RETENTION_DAYS=365

# ==============================================================================
# PostgreSQL 17 Data Warehouse Connection
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=spotify_pulse
POSTGRES_SCHEMA_BRONZE=bronze
POSTGRES_SCHEMA_STAGING=staging
POSTGRES_SCHEMA_GOLD=analytics
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# ==============================================================================
# Apache Airflow Configuration (Containerized via Docker Compose on Windows)
# ==============================================================================
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW_SECRET_KEY=change_me_to_a_secure_random_key_in_production
FERNET_KEY=change_me_to_a_valid_fernet_encryption_key
